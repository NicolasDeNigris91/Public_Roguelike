# Godot 4+ specific ignores
.godot/
/android/
*.uid

# Imported translations (auto-generated from CSV)
*.translation

# Mono-specific (we use GDScript but include for safety)
.mono/
data_*/
mono_crash.*.json

# Export builds
/build/
/exports/
*.pck
*.zip
# Web export output IS committed (Railway serves it via Caddy) — exempt
# web_build/ from the *.pck rule above so the game's data ships in the image.
!web_build/
!web_build/**
# Dev-only local test server — not served in production.
web_build/_serve_local.*

# System / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
